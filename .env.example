# ============================================================
# VISAGISMO — Template de variáveis de ambiente
# ============================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local é ignorado pelo git.
# ============================================================

# ---------- Supabase ----------
# Pegue em: https://supabase.com/dashboard/project/<ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA prefixar com NEXT_PUBLIC_. Server-only.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_PROJECT_REF=

# ---------- Google Gemini ----------
# Pegue em: https://aistudio.google.com/apikey
# Server-only. Sempre dentro de edge functions / route handlers.
GEMINI_API_KEY=

GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_FLASH=gemini-2.5-flash
